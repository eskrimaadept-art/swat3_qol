#include <winver.h>
1 ICON "launcher.ico"
1 24 "launcher.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SWAT 3 QoL project (community mod)"
      VALUE "FileDescription", "SWAT 3 Launcher - settings and mod manager"
      VALUE "FileVersion", "1.0.1.0"
      VALUE "InternalName", "SWAT3Launcher"
      VALUE "OriginalFilename", "SWAT3Launcher.exe"
      VALUE "ProductName", "SWAT 3 Launcher"
      VALUE "ProductVersion", "1.0.1.0"
      VALUE "LegalCopyright", "Unofficial fan-made tool. Not affiliated with the game's publishers."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
